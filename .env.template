TZ=UTC # Set your timezone
LATITUDE=-10.0
LONGITUDE=20.0
INPUT_DEVICE_NAME=default
LOG_LEVEL=INFO
# Minimum (sigmoid) confidence for a detection. BirdNET's own default is 0.25-0.5;
# higher values mean fewer noisy detections, DB writes and HTTP posts.
MIN_CONFIDENCE=0.05
# CPU threads used for TFLite inference
TFLITE_THREADS=1
